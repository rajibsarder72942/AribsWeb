# Copy to .env for local dev. Set the same keys in Cloudflare Pages
# (Settings -> Environment variables). Never commit real values.

# Public (exposed to the browser)
PUBLIC_SITE_URL=https://example.com
# International format, digits only, no "+" (Oman = 968)
PUBLIC_WHATSAPP_NUMBER=96800000000
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets (used by the contact form endpoint)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
