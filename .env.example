# Copy to .env for local dev. On Hostinger, set the same keys in
# hPanel -> Node.js app -> Environment variables. Never commit real values.

# Node server (Hostinger usually sets PORT itself)
HOST=0.0.0.0
PORT=4321

# Public (exposed to the browser)
PUBLIC_SITE_URL=https://example.com
# International format, digits only, no "+" (Oman = 968)
PUBLIC_WHATSAPP_NUMBER=96800000000
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets (used by the contact form endpoint)
TURNSTILE_SECRET_KEY=

# Contact form email via Hostinger SMTP (e.g. smtp.hostinger.com, port 465)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional alternative to SMTP (leave empty when using SMTP)
RESEND_API_KEY=
